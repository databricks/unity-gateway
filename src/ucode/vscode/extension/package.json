{
  "name": "unity-gateway",
  "displayName": "Databricks Unity Gateway",
  "description": "Chat with Databricks AI Gateway models in VS Code through Unity Gateway (ug)",
  "version": "0.1.0",
  "publisher": "databricks",
  "repository": {
    "type": "git",
    "url": "https://github.com/databricks/unity-gateway.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.128.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "databricks-unity-gateway",
        "displayName": "Databricks"
      }
    ],
    "configuration": {
      "title": "Databricks Unity Gateway",
      "properties": {
        "unityGateway.workspace": {
          "type": "string",
          "default": "",
          "description": "Databricks workspace URL, for example https://my-workspace.cloud.databricks.com. Set by `ug configure`.",
          "scope": "application"
        },
        "unityGateway.models": {
          "type": "array",
          "default": [],
          "description": "Models to offer in the chat model picker. Set by `ug configure`.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "api"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Model service name, for example system.ai.claude-sonnet-5-5."
              },
              "api": {
                "type": "string",
                "enum": [
                  "chat_completions",
                  "responses"
                ],
                "description": "The AI Gateway API the model is called through."
              }
            }
          },
          "scope": "application"
        },
        "unityGateway.authCommand": {
          "type": "string",
          "default": "",
          "description": "Command that prints a Databricks access token. Set by `ug configure`.",
          "scope": "application"
        }
      }
    },
    "commands": [
      {
        "command": "unityGateway.refreshModels",
        "title": "Refresh Models",
        "category": "Unity Gateway"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --minify --legal-comments=none --outfile=../src/ucode/vscode/extension/out/extension.js --external:vscode --format=cjs --platform=node --target=node22 && node -e \"require('fs').copyFileSync('package.json', '../src/ucode/vscode/extension/package.json')\"",
    "typecheck": "tsc",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=cjs --target=node22 --outdir=.test-out --alias:vscode=./test/vscode.ts --log-level=warning && node --test .test-out/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/vscode": "1.125.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
